{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/rustfmt.mjs",
            "timeout": 30,
            "statusMessage": "rustfmt"
          }
        ]
      }
    ]
  }
}
